cuito RLC\")\n","plt.grid(True)\n","plt.legend()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":487},"id":"dfsuknPR5flX","executionInfo":{"status":"ok","timestamp":1770221138248,"user_tz":300,"elapsed":111,"user":{"displayName":"Maria Isabel Garcia Quimbayo","userId":"11821565480340800524"}},"outputId":"6accb082-06f8-4345-c76a-fb59a7af10ab"},"execution_count":42,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### 2. Respuesta al escalón\n","\n","La función escalón unitario se define como:\n","\n","$ x(t) = u(t) $\n","\n","donde $u(t)=1$ para $t \\geq 0$."],"metadata":{"id":"4NZGOUSX5iRD"}},{"cell_type":"code","source":["def Vi(t):\n","    return 1.0 if t >= 0 else 0.0"],"metadata":{"id":"gl1jSUxM5qx9","executionInfo":{"status":"ok","timestamp":1770221138285,"user_tz":300,"elapsed":36,"user":{"displayName":"Maria Isabel Garcia Quimbayo","userId":"11821565480340800524"}}},"execution_count":43,"outputs":[]},{"cell_type":"code","source":["solution = solve_ivp(\n","    rlc_system,\n","    t_span,\n","    x0,\n","    t_eval=t_eval\n",")\n","\n","t = solution.t\n","Vc = solution.y[0]\n","\n","plt.figure(figsize=(8,5))\n","plt.plot(t, Vc, label=r\"$V_c(t)$\")\n","plt.xlabel(\"Tiempo [s]\")\n","plt.ylabel(\"Voltaje [V]\")\n","plt.title(\"Respuesta al escalón del circuito RLC\")\n","plt.grid(True)\n","plt.legend()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":488},"id":"E4PftKHn5sRA","executionInfo":{"status":"ok","timestamp":1770221138424,"user_tz":300,"elapsed":138,"user":{"displayName":"Maria Isabel Garcia Quimbayo","userId":"11821565480340800524"}},"outputId":"86c722ab-7647-483c-8104-3bcacd2ab4be"},"execution_count":44,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### 3. Respuesta a una señal sinusoidal\n","\n","Se considera una entrada sinusoidal de amplitud unitaria y frecuencia angular $\\omega$:\n","\n","$ x(t) = \\sin(\\omega t) $"],"metadata":{"id":"fT4XiT8V56KF"}},{"cell_type":"code","source":["A = 1.0\n","omega = 2 * np.pi  # frecuencia angular (rad/s)\n","\n","def Vi(t):\n","    return A * np.sin(omega * t)"],"metadata":{"id":"Td1_1qLr5wAp","executionInfo":{"status":"ok","timestamp":1770221138425,"user_tz":300,"elapsed":4,"user":{"displayName":"Maria Isabel Garcia Quimbayo","userId":"11821565480340800524"}}},"execution_count":45,"outputs":[]},{"cell_type":"code","source":["solution = solve_ivp(\n","    rlc_system,\n","    t_span,\n","    x0,\n","    t_eval=t_eval\n",")\n","\n","t = solution.t\n","Vc = solution.y[0]\n","\n","plt.figure(figsize=(8,5))\n","plt.plot(t, Vc, label=r\"$V_c(t)$\")\n","plt.xlabel(\"Tiempo [s]\")\n","plt.ylabel(\"Voltaje [V]\")\n","plt.title(\"Respuesta a entrada sinusoidal del circuito RLC\")\n","plt.grid(True)\n","plt.legend()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":487},"id":"DBIaS5EZ6BKa","executionInfo":{"status":"ok","timestamp":1770221138571,"user_tz":300,"elapsed":148,"user":{"displayName":"Maria Isabel Garcia Quimbayo","userId":"11821565480340800524"}},"outputId":"b01461fa-d63a-476f-adcd-33ef4094e979"},"execution_count":46,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### 4. Respuesta a una señal cosenoidal\n","\n","La señal cosenoidal se define como:\n","\n","$ x(t) = \\cos(\\omega t) $\n","\n","con la misma frecuencia angular $\\omega$."],"metadata":{"id":"LURymQv-6Jdi"}},{"cell_type":"code","source":["A = 1.0\n","omega = 2 * np.pi  # frecuencia angular (rad/s)\n","\n","def Vi(t):\n","    return A * np.cos(omega * t)"],"metadata":{"id":"DdymOYjp6DMH","executionInfo":{"status":"ok","timestamp":1770221138573,"us